# Secrets & local machine config — NEVER commit
.mcp.json
.env
.env.*
*.local
# Per-machine Claude Code settings (local hook paths, permission grants). The `*.local`
# glob above does NOT match this filename (it ends in .json), so name it explicitly.
.claude/settings.local.json

# Live working file (gitignored per ops/ convention in CLAUDE.md)
ops/STATE.md

# OS / tooling noise
.DS_Store
node_modules/
__pycache__/
*.pyc

# Session scratch — never publish
.claude/tmp/

# Resume build fonts: if you keep per-application font copies, they're build inputs, not
# deliverables (the PDF is) — uncomment if that gets noisy:
# applications/*/resume/fonts/
# applications/*/cover-letter/fonts/
