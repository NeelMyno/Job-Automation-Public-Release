{
  "description": "Codex lifecycle enforcement for this repo. scripts/hooks.py remains the gate owner; codex_hook_adapter.py translates Codex payloads and enforces Codex-specific policy.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks.py\" --session-start",
            "timeout": 60,
            "statusMessage": "Deriving live repo state",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hook_adapter.py\" --timestamp-inject",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|WebFetch|web_fetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hook_adapter.py\" --pre-tool",
            "timeout": 10,
            "statusMessage": "Checking repository safety policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Claude_Browser__.*|mcp__claude-in-chrome__.*|mcp__chrome-devtools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hook_adapter.py\" --post-tool",
            "timeout": 15,
            "statusMessage": "Checking browser tabs for logged-in accounts"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hook_adapter.py\" --post-edit",
            "timeout": 45,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks.py\" --stop",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hook_adapter.py\" --timestamp-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
